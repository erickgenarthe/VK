rules_version = '2';
// Regras do "Outubro da Criança". Use um projeto Firebase só para este site
// (se misturar com o SERVE, as regras abertas do SERVE liberam a leitura dos telefones).
// Troque o e-mail abaixo pelo(s) e-mail(s) da liderança que podem ver as doações.
service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null && request.auth.token.email in ['SEU_EMAIL@exemplo.com'];
    }

    // Quem escaneia o QR Code só consegue CRIAR uma doação (nunca ler as dos outros).
    match /doacoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome','whatsapp','itens','obs','status','criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 80
                    && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('^55[0-9]{10,11}$')
                    && request.resource.data.itens is list && request.resource.data.itens.size() >= 1 && request.resource.data.itens.size() <= 8
                    && request.resource.data.obs is string && request.resource.data.obs.size() <= 300
                    && request.resource.data.status == 'novo'
                    && request.resource.data.criadoEm == request.time;
      allow read, update, delete: if admin();
    }

    // Telão e torre: só primeiro nome + item, de leitura pública.
    match /mural/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nome','item','itemId','criadoEm'])
                    && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
                    && request.resource.data.item is string && request.resource.data.item.size() <= 140
                    && request.resource.data.criadoEm == request.time;
      allow update, delete: if admin();
    }

    // Contadores da brinquedoteca (total e quantos de cada item): o público só consegue somar 1 doação por vez.
    match /publico/resumo {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['total','porItem']) && request.resource.data.total == 1;
      allow update: if request.resource.data.keys().hasOnly(['total','porItem']) && request.resource.data.total == resource.data.total + 1;
      allow update, delete: if admin();
    }
  }
}
